{
  "FormatVersion": 3,
  "Id": "18e0cf0e-af1a-531c-a999-1c10e053b797",
  "Description": "Reads the Blender camera rail and outputs interpolated pose, lens, clip planes, and source time. The project TimeClips drive OverrideTime for shared camera, geometry, material, light, and world timing. WorldStartSeconds selects the active Blender world from source time; ActiveWorld remains available as a fallback.",
  "InputUis": [
    {"InputId":"0713a026-3b7b-5ddf-ac49-e585d8248fa6","GroupTitle":"Blender export","Description":"Path to the camera_60hz.bin file exported from Blender."},
    {"InputId":"df42be73-5639-53e6-82f4-f72a9b15aba6","GroupTitle":"Playback","Description":"Explicit time in seconds when UseOverride is enabled."},
    {"InputId":"8e21625b-2c15-5b6c-8b42-78aa3500bf8b","GroupTitle":"Playback","Description":"Use OverrideTime instead of the host timeline clock."},
    {"InputId":"9aaf2997-d503-5100-97db-9e3f19bd0e50","GroupTitle":"Scene routing","Description":"Fallback zero-based world index when WorldStartSeconds is empty."},
    {"InputId":"70bceb8e-15a0-592f-a01b-ff73dfac2a59","GroupTitle":"Scene routing","Description":"Optional JSON sidecar with source-time shots/passages and output-to-source time_map points. Leave empty for a plain camera rail."},
    {"InputId":"2748faa0-a40e-5a5e-8810-1170aff75f74","GroupTitle":"Scene routing","Description":"Comma-separated source-time seconds at which each Blender world begins. The active world follows retimed clip source time."}
  ]
}
