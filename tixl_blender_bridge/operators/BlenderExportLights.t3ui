{
  "FormatVersion": 3,
  "Id": "ed467242-caba-58ac-b8e9-69a494a93e39",
  "Description": "Preloads every Blender light manifest and keyed channel set on a paused initialization frame. WorldDirectory contains <scene>_manifest.json and optional <scene>_channels.json files. WorldIndex selects cached lights, TimeSeconds samples their animation, and EnergyScale calibrates Blender energy to TiXL point-light units. The operator forwards the incoming Command after pushing lights.",
  "InputUis": [
    {"InputId":"15864c39-8af3-501d-9be8-3e07898e1060","GroupTitle":"Command"},
    {"InputId":"e0a26c9d-fc85-59a7-88b5-1d1b0d8c5c3f","GroupTitle":"Blender export","Description":"Directory containing exported light manifests and channel files."},
    {"InputId":"fc6c833a-fcc3-506a-9808-f2f5e0d21c17","GroupTitle":"Blender export","Description":"Zero-based scene index matching the manifest set."},
    {"InputId":"51c24b39-749f-5bba-8c24-3c8376e49112","GroupTitle":"Playback","Description":"Time in seconds used to sample keyed light channels."},
    {"InputId":"48ad955c-730a-5e12-866b-938588a436ea","GroupTitle":"Calibration","Description":"Multiplier converting Blender light energy to TiXL point-light energy."},
    {"InputId":"a17e4d92-6c38-4f0b-b5d1-2e9a7c8f6043","GroupTitle":"Blender export","Description":"Comma-separated manifest basenames. The selected WorldIndex chooses one name."}
  ]
}
